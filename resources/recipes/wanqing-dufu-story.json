  "couplets": [
    {
      "start": 3.63,
      "end": 6.38,
      "text": "返照斜初彻，浮云薄未归。"
    },
    {
      "start": 6.39,
      "end": 9.31,
      "text": "江虹明远饮，峡雨落余飞。"
    },
    {
      "start": 9.32,
      "end": 15.2,
      "text": "凫雁终高去，熊罴觉自肥。"
    },
    {
      "start": 15.21,
      "end": 22.0,
      "text": "秋分客尚在，竹露夕微微。"
    }
